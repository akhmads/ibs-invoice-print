# Salin menjadi .env lalu sesuaikan.

# Aplikasi Node hanya listen di localhost; akses dari luar lewat Caddy.
PORT=3000
HOST=127.0.0.1

# Koneksi SQL Server (2016 di produksi / 2022 docker di lokal)
DB_SERVER=localhost
DB_PORT=1433
# Jika memakai named instance (mis. SERVER\SQL2016), isi DB_INSTANCE dan DB_PORT diabaikan
# DB_INSTANCE=SQL2016
DB_NAME=IBSFin
DB_USER=sa
DB_PASSWORD=

DB_ENCRYPT=true
# true jika sertifikat SQL Server self-signed (umumnya begitu di server internal)
DB_TRUST_CERT=true
